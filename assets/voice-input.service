[Unit]
Description=Omarchy-native Voice Input daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment=VOICE_INPUT_ASSET_DIR=@VOICE_INPUT_ASSET_DIR@
Environment=VOICE_INPUT_EXTERNAL_HUD=1
# Relative credential IDs are looked up in the per-user systemd encrypted
# credential stores. Missing credentials are non-fatal for local-only use.
LoadCredentialEncrypted=alibaba-api-key
LoadCredentialEncrypted=openrouter-api-key
ExecStart=@VOICE_INPUT_BIN@ daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
